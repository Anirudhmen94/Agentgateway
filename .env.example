# xAI key for grok-4.6. Leave empty to use the local heuristic fallback.
# Fallback is not model quality. Classifier model field: local-fallback (never grok-4.6).
# Split reporting: model=fallback vs model=grok. Do not cite heuristic coverage as grok detection.
XAI_API_KEY=

# When 1/true/yes/on: if grok-4.6 is unavailable or the API call fails, deny instead of
# running the local heuristic. Default 0 keeps the demo/eval fallback (still not grok quality).
FAIL_CLOSED=0

# Shared demo token for mutating/control routes (POST /v1/check, /v1/revoke*, audit stream).
# Required. Empty or missing token fails closed (401). Do not commit a real secret.
#
# Primary auth header (required contract):
#   Authorization: Bearer <GATEWAY_TOKEN>
# Optional alias:
#   X-Gateway-Token: <GATEWAY_TOKEN>
GATEWAY_TOKEN=change-me-before-demo

# Listen address. Process default is 127.0.0.1 (not 0.0.0.0).
# Windows: .\scripts\start.ps1  |  python -m src.app
# Override: GATEWAY_HOST / GATEWAY_PORT or --host / --port
# Docker Compose sets 0.0.0.0 inside the container on purpose; host publish is 127.0.0.1:8000.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

CLASSIFIER_CONCURRENCY=2

# Optional. Default is out/revocations.json (survives process restart).
# REVOCATION_STORE_PATH=out/revocations.json

# Per-agent session quota: request counts over a sliding window.
# Limits live on each agent in config/agents.yaml (`quota_limit`).
# Window (seconds) from env, or per-agent `quota_window_seconds` when set.
# File-backed like revoke so a demo restart keeps counts.
QUOTA_WINDOW_SECONDS=3600
# QUOTA_STORE_PATH=out/quotas.json
# Fallback when an agent omits quota_limit. 0 = unlimited.
# QUOTA_DEFAULT_LIMIT=0
